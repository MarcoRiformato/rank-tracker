# DataForSEO API login and password from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Maps search settings. Depth above 100 is billed as an extra SERP, so it is capped at 100.
DATAFORSEO_LANGUAGE_CODE=it
DATAFORSEO_SE_DOMAIN=google.it
DATAFORSEO_DEVICE=mobile
DATAFORSEO_DEPTH=20

# Set to true to scan with fake listings and skip DataForSEO.
USE_DUMMY_MODE=false

# Optional. Leave unset to keep the built-in local session key.
SECRET_KEY=
